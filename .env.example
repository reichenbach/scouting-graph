# Copy to .env and fill in. .env is gitignored and must stay that way.
ANTHROPIC_API_KEY=sk-ant-...

# Optional. Set to 1 to run the whole pipeline with a deterministic stub and
# no network. Set to "fabricate" to run a stub that invents a number, which
# demonstrates the fail closed path.
# YDS_GRAPH_STUB=1

# Optional. Overrides the repository root used for inbox, outbox, errors,
# state and audit.sqlite. The tests set this to a temporary directory.
# YDS_GRAPH_HOME=/path/to/checkout
